DISCORD_TOKEN=
LAVALINK_HOST=
LAVALINK_PORT=443
LAVALINK_SECURE=true
LAVALINK_PASSWORD=

# Required: PostgreSQL connection URL from Supabase Connect (never an API URL or API key).
DATABASE_URL=

# --- Optional ---------------------------------------------------------------------------------
# Port for the health/ping server (Render and Koyeb inject PORT themselves).
PORT=3000

# Your own support server, shown on the idle panel. Leave empty to hide the Support link.
SUPPORT_INVITE_URL=

# Permissions for the generated Invite link. Default is Administrator (8).
INVITE_PERMISSIONS=8

# Contact URL used in the LRCLIB User-Agent, so LRCLIB can reach you about unusual usage.
REPOSITORY_URL=
